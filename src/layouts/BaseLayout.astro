---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Home renders its own intro instead of the site header. */
  bare?: boolean;
}
const { title, description = 'Personal site of Alex Stevens.', bare = false } = Astro.props;
const fullTitle = title === 'Alex Stevens' ? title : `${title} · Alex Stevens`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
  </head>
  <body>
    {!bare && <Header />}
    <main id="main" class="page">
      <slot />
    </main>
    <Footer />
  </body>
</html>
