---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { loadAllProjects, syncContentToPublic } from '../../lib/content';

syncContentToPublic();
const projects = await loadAllProjects();
---
<BaseLayout title="Projects" description="Selected projects by Alex Stevens.">
  <h1>Projects</h1>
  <p class="lede">Selected work. Open a card for details.</p>
  <div class="project-grid" style="margin-top: 1.5rem;">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</BaseLayout>
