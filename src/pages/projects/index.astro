---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadAllProjects, loadBioLine } from '../../lib/content';

const projects = (await loadAllProjects()).filter((project) => project.hasContent);
const description = loadBioLine() || 'Projects by Alex Stevens.';
---

<BaseLayout title="Projects" description={description}>
  <h1 class="page-title">Projects</h1>
  <ol class="index">
    {
      projects.map((project) => (
        <li>
          <a href={`/projects/${project.def.slug}/`}>
            <span class="index__title">{project.title}</span>
            {project.statusLabel && <span class="index__status">{project.statusLabel}</span>}
            {project.hook && <span class="index__hook">{project.hook}</span>}
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>
