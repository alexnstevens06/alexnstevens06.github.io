---
import BaseLayout from '../layouts/BaseLayout.astro';
import TodoBox from '../components/TodoBox.astro';
import { loadTimeline, syncContentToPublic } from '../lib/content';

syncContentToPublic();
const timeline = await loadTimeline();

// Galleries matched to an entry are shown under that heading context via body + gallery sections.
// Unmatched galleries get their own section labeled with the folder name (no invented captions).
const unmatched = timeline.galleries.filter((g) => !g.matchedEntryTitle);
const matched = timeline.galleries.filter((g) => g.matchedEntryTitle);
---
<BaseLayout title="Timeline" description="Semester-by-semester path.">
  {!timeline.hasTimeline ? (
    <TodoBox message="content pending — add content/timeline.md." />
  ) : (
    <article class="prose timeline-prose" set:html={timeline.bodyHtml} />
  )}

  {matched.map((g) => (
    <section aria-labelledby={`gal-${g.folder}`} style="margin-top: 2.5rem;">
      <h2 id={`gal-${g.folder}`}>{g.matchedEntryTitle}</h2>
      <div class="gallery" role="list">
        {g.media.map((item, i) => (
          <figure role="listitem" class={i === 0 ? 'gallery__lead' : undefined}>
            <img
              src={item.relUrl}
              alt=""
              width="960"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <figcaption>{item.name}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))}

  {unmatched.map((g) => (
    <section aria-labelledby={`gal-${g.folder}`} style="margin-top: 2.5rem;">
      <h2 id={`gal-${g.folder}`}>{g.label}</h2>
      <div class="gallery" role="list">
        {g.media.map((item, i) => (
          <figure role="listitem" class={i === 0 ? 'gallery__lead' : undefined}>
            <img
              src={item.relUrl}
              alt=""
              width="960"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{item.name}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
