---
import BaseLayout from '../layouts/BaseLayout.astro';
import TodoBox from '../components/TodoBox.astro';
import { loadTimeline, syncContentToPublic } from '../lib/content';

syncContentToPublic();
const timeline = await loadTimeline();

/** Galleries shown under their matched timeline entry (headline already on the rail). */
const galleryByTitle = new Map(
  timeline.galleries.filter((g) => g.matchedEntryTitle).map((g) => [g.matchedEntryTitle!, g]),
);
const unmatched = timeline.galleries.filter((g) => !g.matchedEntryTitle);

/** Group entries by period for the vertical timeline. */
const periods: { period: string; entries: typeof timeline.entries }[] = [];
for (const e of timeline.entries) {
  const last = periods[periods.length - 1];
  if (last && last.period === e.period) last.entries.push(e);
  else periods.push({ period: e.period, entries: [e] });
}
---
<BaseLayout title="Timeline" description="Semester-by-semester path from Summer 2024 onward.">
  <h1>Timeline</h1>
  <p class="lede">Semester-by-semester path. Project deep-dives link out where available.</p>

  {timeline.entries.length === 0 ? (
    <TodoBox message="content pending — add content/timeline.md." />
  ) : (
    <ol class="vtimeline">
      {periods.map((block) => (
        <li class="vtimeline__period">
          <h2 class="vtimeline__period-title">{block.period}</h2>
          <ol class="vtimeline__entries">
            {block.entries.map((e) => {
              const gal = galleryByTitle.get(e.title);
              const href = e.projectSlug ? `/projects/${e.projectSlug}/` : null;
              return (
                <li class="vtimeline__entry">
                  <div class="vtimeline__marker" aria-hidden="true" />
                  <div class="vtimeline__card">
                    <h3 class="vtimeline__title">
                      {href ? <a href={href}>{e.title}</a> : e.title}
                    </h3>
                    <p class="vtimeline__blurb">{e.blurb}</p>
                    {e.thumb && (
                      <a
                        class:list={['vtimeline__cover', e.thumb.needsMatte && 'vtimeline__cover--matte']}
                        href={href || undefined}
                        tabindex={href ? undefined : -1}
                      >
                        <img
                          src={e.thumb.relUrl}
                          alt=""
                          width="960"
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    )}
                    {href && (
                      <p class="vtimeline__link">
                        <a href={href}>View project →</a>
                      </p>
                    )}
                    {gal && gal.media.length > 1 && (
                      <div
                        class:list={['gallery', 'gallery--compact', gal.useMatte && 'gallery--matte']}
                        role="list"
                      >
                        {gal.media.slice(1).map((item) => (
                          <figure
                            role="listitem"
                            class:list={[item.needsMatte && 'gallery__matte']}
                          >
                            <img
                              src={item.relUrl}
                              alt=""
                              width="640"
                              loading="lazy"
                              decoding="async"
                            />
                            <figcaption>{item.name}</figcaption>
                          </figure>
                        ))}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </li>
      ))}
    </ol>
  )}

  {unmatched.map((g) => (
    <section aria-labelledby={`gal-${g.folder}`} style="margin-top: 2.5rem;">
      <h2 id={`gal-${g.folder}`}>{g.label}</h2>
      <div class:list={['gallery', g.useMatte && 'gallery--matte']} role="list">
        {g.media.map((item, i) => (
          <figure
            role="listitem"
            class:list={[i === 0 && 'gallery__lead', item.needsMatte && 'gallery__matte']}
          >
            <img
              src={item.relUrl}
              alt=""
              width="960"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <figcaption>{item.name}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
