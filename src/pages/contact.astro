---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadAbout, syncContentToPublic } from '../lib/content';

syncContentToPublic();
const about = await loadAbout();
const hasAny = Boolean(about.email || about.links.length);
---
<BaseLayout title="Contact" description="Contact Alex Stevens.">
  <h1>Contact</h1>
  {hasAny ? (
    <ul class="meta-list" style="margin-top: 1.5rem;">
      {about.email && (
        <li>
          <strong>Email:</strong>{' '}
          <a href={`mailto:${about.email}`}>{about.email}</a>
        </li>
      )}
      {about.links.map((link) => (
        <li>
          <strong>{link.label}:</strong>{' '}
          <a href={link.href} rel="noopener noreferrer">{link.href}</a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="lede">No public contact links published yet.</p>
  )}
</BaseLayout>
