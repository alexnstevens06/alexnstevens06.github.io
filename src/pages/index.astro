---
import BaseLayout from '../layouts/BaseLayout.astro';
import TodoBox from '../components/TodoBox.astro';
import Img from '../components/Img.astro';
import { loadAbout, loadBioLine, loadHomeTimeline } from '../lib/content';

const about = await loadAbout();
const bioLine = loadBioLine();
const entries = await loadHomeTimeline();
const links = [
  ...(about.email ? [{ label: 'Email', href: `mailto:${about.email}` }] : []),
  ...about.links,
  ...(about.resumeHref ? [{ label: 'Resume', href: about.resumeHref }] : []),
];
---
<BaseLayout title="Alex Stevens" description={bioLine || 'Alex Stevens — timeline of work and projects.'} bare>
  <header class="intro">
    {about.headshotRelUrl && (
      <Img class="intro__photo" src={about.headshotRelUrl} width={144} alt="Headshot of Alex Stevens" eager />
    )}
    <div>
      <h1 class="intro__name">Alex Stevens</h1>
      {bioLine && <p class="intro__bio">{bioLine}</p>}
      {links.length > 0 && (
        <p class="intro__links">
          {links.map((l) => (
            <a href={l.href} rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{l.label}</a>
          ))}
        </p>
      )}
    </div>
  </header>

  {entries.length === 0 ? (
    <TodoBox message="content pending — add content/timeline.md." />
  ) : (
    <ol class="tl">
      {entries.map((e, i) => {
        const Tag = e.href ? 'a' : 'div';
        return (
          <li>
            <Tag class:list={['tl__row', e.cover ? 'tl__row--cover' : 'tl__row--text']} href={e.href ?? undefined}>
              {e.cover ? (
                <div class:list={['tl__media', e.cover.needsMatte && 'matte']}>
                  <Img src={e.cover.relUrl} width={900} eager={i === 0} />
                </div>
              ) : (
                e.period && <p class="tl__period tl__period--side">{e.period}</p>
              )}
              <div class="tl__text">
                <h2 class="tl__title">{e.title}</h2>
                {e.cover && e.period && <p class="tl__period">{e.period}</p>}
                {e.bodyHtml && <p class="tl__body" set:html={e.bodyHtml} />}
                {e.href && <span class="tl__more">View project →</span>}
              </div>
            </Tag>
          </li>
        );
      })}
    </ol>
  )}
</BaseLayout>
