---
import BaseLayout from '../layouts/BaseLayout.astro';
import TodoBox from '../components/TodoBox.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { loadAbout, loadAllProjects, loadTimeline, syncContentToPublic } from '../lib/content';

syncContentToPublic();
const about = await loadAbout();
const projects = await loadAllProjects();
const timeline = await loadTimeline();
---
<BaseLayout title="Alex Stevens" description="About Alex Stevens and selected projects.">
  <section class="hero" aria-labelledby="about-heading">
    {about.headshotRelUrl ? (
      <img
        class="avatar"
        src={about.headshotRelUrl}
        alt="Headshot of Alex Stevens"
        width="160"
        height="160"
        loading="eager"
        decoding="async"
      />
    ) : null}
    <div>
      <h1 id="about-heading">Alex Stevens</h1>
      {about.hasBio && about.bioHtml ? (
        <div class="prose" set:html={about.bioHtml} />
      ) : (
        <TodoBox message="content pending — add content/about/bio.md (or README.md) with a short bio." />
      )}
      <div class="btn-row">
        {about.resumeHref && (
          <a class="btn btn--primary" href={about.resumeHref}>Resume</a>
        )}
        <a class="btn" href="/projects/">Projects</a>
        <a class="btn" href="/timeline/">Timeline</a>
        <a class="btn" href="/contact/">Contact</a>
        {about.github && (
          <a class="btn" href={about.github} rel="noopener noreferrer">GitHub</a>
        )}
      </div>
    </div>
  </section>

  {timeline.teaserEntries.length > 0 && (
    <section aria-labelledby="timeline-heading" style="margin-bottom: 2.5rem;">
      <div class="section-head">
        <h2 id="timeline-heading">Timeline</h2>
        <a href="/timeline/">Full timeline →</a>
      </div>
      <p class="teaser-note">Selected stops from 2024 → 2026. Open the full timeline for every semester.</p>
      <ul class="teaser-list">
        {timeline.teaserEntries.map((e) => {
          const href = e.projectSlug ? `/projects/${e.projectSlug}/` : '/timeline/';
          return (
            <li class={`teaser-item${e.thumb ? '' : ' teaser-item--text'}`}>
              {e.thumb && (
                <img
                  class:list={['teaser-item__thumb', e.thumb.needsMatte && 'teaser-item__thumb--matte']}
                  src={e.thumb.relUrl}
                  alt=""
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="teaser-item__text">
                <p class="teaser-item__period">{e.period}</p>
                <p class="teaser-item__title">
                  <a href={href}>{e.title}</a>
                </p>
                <p class="teaser-item__blurb">{e.blurb}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section aria-labelledby="featured-heading">
    <div class="section-head">
      <h2 id="featured-heading">Projects</h2>
      <a href="/projects/">View all</a>
    </div>
    <div class="project-grid">
      {projects.slice(0, 6).map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</BaseLayout>
